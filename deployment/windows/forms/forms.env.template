# Compatibility filename. Use forms.production.env.template as the production source template.
FORMS_MODE=production
NODE_ENV=production
CONTACT_RECIPIENT_EMAIL=admin@lakeoilgroup.com
CAREERS_RECIPIENT_EMAIL=admin@lakeoilgroup.com
CONTACT_ALLOWED_ORIGINS=https://www.lakeoilgroup.com
CAREERS_ALLOWED_ORIGINS=https://www.lakeoilgroup.com
SMTP_HOST=<LAKE_APPROVED_SMTP_HOST>
SMTP_PORT=<SMTP_PORT>
SMTP_SECURE=<true_or_false>
SMTP_USER=<SERVER_SIDE_SMTP_ACCOUNT>
SMTP_PASS=<SERVER_ONLY_SECRET>
MAIL_FROM=<APPROVED_LAKE_GROUP_SENDER>
DATABASE_URL_RUNTIME=<PRIVATE_LAKE_POSTGRES>
# Windows default: Microsoft Defender. Use clamd only with the two loopback settings below.
CAREERS_SCANNER_PROVIDER=defender
# CAREERS_CLAMD_HOST=127.0.0.1
# CAREERS_CLAMD_PORT=3310
PUBLIC_FORM_TOKEN_SECRET=<SERVER_GENERATED_SECRET>
