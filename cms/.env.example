# API base URL for deployments where the backend is NOT same-origin.
# In development the Vite proxy serves /auth /admin /api /health same-origin,
# so leave this empty (default).
#
# Example:
# VITE_API_BASE_URL=https://lake-group-backend.example.com
#
# Production should use custom subdomains under the same registrable domain
# (for example cms.example.com + api.example.com). They are separate origins
# for CORS but remain same-site for the backend's SameSite=Lax session cookie.
# Add the CMS origin to both backend CMS_ALLOWED_ORIGINS and
# CSRF_ALLOWED_ORIGINS.
#
# Only browser-safe values belong here. Never put DATABASE_URL, SESSION_SECRET,
# or any private credential into Vite environment variables — they ship to
# the browser bundle.
VITE_API_BASE_URL=
