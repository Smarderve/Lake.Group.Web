# CMS production environment — TEMPLATE ONLY. Never import this into a
# deployment dashboard: it contains only safe, non-secret values, and a real
# deployment must set them via the platform environment variables.
#
# Copy to `.env.production` (gitignored) for local `npm run build` checks.
#
# OPTIONAL on Vercel: `src/services/api.ts` now defaults production builds to
# the deployed backend below, so a Vercel deployment works with ZERO
# environment variables. Set this only to override the default (e.g. a custom
# api.lakegroup.com domain). VITE_* are build-time — a redeploy is required
# after any change.

# API base URL — the deployed backend. The CMS appends `/auth/login`,
# `/admin/...`, `/health` directly (NO `/api` prefix — the backend mounts
# auth at /auth and public at /api/public).
VITE_API_BASE_URL=https://lake-group-web-backend.onrender.com

# Public Lake Group website origin — used to resolve website-relative media
# paths (assets/...) in the Media Library and editors.
VITE_PUBLIC_SITE_URL=https://lake-group.vercel.app
