# Render staging environment — TEMPLATE ONLY.
#
# NEVER import this file into Render: it contains placeholders, not values.
# To deploy, create `backend/.env.render.staging` (gitignored) from this
# template, fill the <...> values from their documented sources, then import
# THAT file via Render → Service → Environment → Add from .env.
#
# MFA_ENCRYPTION_KEY is the most sensitive: the migrated Render database
# contains TOTP secrets sealed with the key in `backend/.env` — Render MUST
# use that exact key (metadata check: present=true, decodedBytes=32,
# formatValid=true). Do NOT generate or rotate a key.

NODE_ENV=staging

# Copy from Render → your PostgreSQL → Connections → INTERNAL Database URL
# (NOT the External URL, and never the local 127.0.0.1 URL). Same value twice.
DATABASE_URL=<RENDER_INTERNAL_DATABASE_URL>
DATABASE_URL_RUNTIME=<RENDER_INTERNAL_DATABASE_URL>

# Render injects PORT automatically — do not set it here.

LOG_LEVEL=info
TRUST_PROXY=1

SESSION_SECRET=<SET_IN_RENDER>
SESSION_TTL_MS=28800000
SESSION_ROLLING=true
RECENT_AUTH_WINDOW_MS=900000
BCRYPT_COST=12
SESSION_COOKIE_SECURE=true

# The exact deployed CMS origin (e.g. https://<cms-project>.vercel.app or
# https://cms.lakegroup.com), HTTPS only, never "*". Same origin in both lists.
CSRF_ALLOWED_ORIGINS=<ACTUAL_CMS_ORIGIN>
CMS_ALLOWED_ORIGINS=<ACTUAL_CMS_ORIGIN>

# The exact raw value from backend/.env (the key that sealed the migrated
# database's MFA secrets). Metadata-only check: 32 bytes, canonical base64.
MFA_ENCRYPTION_KEY=<EXISTING_MIGRATED_DB_KEY>
MFA_REQUIRED_ROLES=SUPER_ADMIN,EDITOR,REVIEWER,CONTACT_MANAGER,VIEWER

# Demo login convenience — staging only. NEVER set in production (boot failure).
DEV_MFA_SKIP_EMAILS=cms-dev@lakegroup.com

METRIC_STALE_DAYS=180
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_LOCAL_DIR=./uploads
MEDIA_UPLOAD_MAX_BYTES=10485760
