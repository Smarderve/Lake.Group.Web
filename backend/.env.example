# ── Lake Group backend — environment template ────────────────────────────
# Copy this file to `.env` and replace the placeholders with your real
# values. NEVER commit `.env` — it is gitignored.

# ── Environment separation (SECURITY_ROADMAP Phase 1) ─────────────────────
# One of: development | testing | staging | production (default development).
# Production: /example dev routes are NOT mounted, secure cookies + HSTS are
# required, and the boot check refuses to start with weak secrets.
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
# Local PostgreSQL connection string. The database runs on the company
# server itself (localhost) — no external or paid services.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# SECURITY_ROADMAP Phase 6 — least-privilege split:
#   DATABASE_URL         = lake_user (migration/DDL owner) — used by
#                          `npm run db:migrate`, seeds, backup/restore.

# SECURITY_ROADMAP Phase 20 — backup/DR. Optional AES-256-GCM encryption-
# at-rest for dumps: set a long random passphrase to make backups opaque
# (BACKUP_ENCRYPTION_KEY). Retention: BACKUP_RETENTION_DAYS (default 14, 0 =
# keep everything) prunes dumps older than the window after each backup.
# See docs/security/disaster-recovery.md.
BACKUP_ENCRYPTION_KEY="change_me_generate_a_separate_64_character_random_value"
BACKUP_RETENTION_DAYS=14
# Object prefix for the encrypted offsite copy written after pg_dump.
# Production boot requires this and MEDIA_STORAGE_DRIVER=s3.
BACKUP_STORAGE_PREFIX="production/backups/"
#   DATABASE_URL_RUNTIME = lake_app  (DML-only runtime role, no DDL) — used
#                          by the running server + session store.
# Provision the role once per cluster: node scripts/db-roles.js
# (see docs/security/phase-06-report.md).
DATABASE_URL="postgresql://lake_user:change_me@localhost:5432/lakegroup?schema=public"
DATABASE_URL_RUNTIME="postgresql://lake_app:change_me_too@localhost:5432/lakegroup?schema=public"

# ── Server ───────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=4000

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Use 0 for direct TLS; 1 only when the backend is reachable exclusively
# through exactly one trusted ingress; otherwise list exact proxy IP/CIDR
# entries (for example "10.20.0.0/16,10.30.0.10"). Values such as true,
# hostnames, negative values, and hop counts above 1 fail production boot.
# Forwarded host/protocol are accepted only from a network-trusted direct peer.
TRUST_PROXY=0

# ── Auth & sessions (Phase 2) ────────────────────────────────────────────
# Session signing secret. Generate a strong one, e.g.:
#   openssl rand -hex 32
SESSION_SECRET="change_me_generate_a_real_random_value"

# Session cookie lifetime in ms (default 8 hours). With rolling sessions
# (below) this acts as an inactivity timeout, not a fixed lifetime.
SESSION_TTL_MS=28800000

# Idle expiry (SECURITY_ROADMAP Phase 3): re-set the session cookie on
# activity so SESSION_TTL_MS becomes a max-inactivity window. Default true;
# set "false" for a fixed (non-extending) session lifetime.
SESSION_ROLLING=true

# Window (ms) within which a session counts as "recently authenticated"
# for privileged actions (default 15 minutes).
RECENT_AUTH_WINDOW_MS=900000

# bcrypt cost factor for password hashing (default 12 — above bcrypt's
# own default of 10). Higher = slower but stronger.
BCRYPT_COST=12

# Production requires MFA enrollment for every CMS role. The default is the
# complete list below when NODE_ENV=production; keep it explicit in deployed
# configuration so role additions are reviewed.
MFA_REQUIRED_ROLES=SUPER_ADMIN,EDITOR,REVIEWER,CONTACT_MANAGER,VIEWER
# Separate 32-byte key for AES-256-GCM protection of TOTP seeds at rest:
#   openssl rand -base64 32
MFA_ENCRYPTION_KEY="change_me_generate_exactly_32_base64_bytes"

# DEVELOPMENT-ONLY: comma-separated emails that skip the TOTP step at login
# (the password is still required and verified). Lets a local demo account
# with MFA enrolled be used without an authenticator app. Setting this in
# production is a BOOT FAILURE (see productionConfigProblems) so it can
# never accidentally weaken real accounts. Leave empty in any deployed env.
DEV_MFA_SKIP_EMAILS=

# Force secure (HTTPS-only) session cookies. Auto-enabled when
# NODE_ENV=production; set to "false" only if the server is not behind TLS.
SESSION_COOKIE_SECURE=false

# ── CSRF (SECURITY_ROADMAP Phase 8) ────────────────────────────────────
# Extra origins allowed to send state-changing requests to /admin and /auth
# (the static admin UI lives on another origin in dev/test/prod). Same-host
# is always allowed. Comma-separated. Leave empty to allow only same-origin.
#   CSRF_ALLOWED_ORIGINS="http://127.0.0.1:8796,https://cms.example.com"
CSRF_ALLOWED_ORIGINS="http://127.0.0.1:8796"

# ── CMS CORS (specification Phase 18) ───────────────────────────────────
# Exact browser origins allowed to read credentialed /auth, /admin, and
# /health responses. Never use "*": session cookies require an exact origin
# plus Access-Control-Allow-Credentials. Every production value must be an
# HTTPS origin and must also appear in CSRF_ALLOWED_ORIGINS.
#   CMS_ALLOWED_ORIGINS="https://cms.example.com"
CMS_ALLOWED_ORIGINS="http://127.0.0.1:5173"

# ── Metrics governance (Phase 3) ────────────────────────────────────────
# Stale-data window: metrics whose verificationDate is older than this
# many days (or never set) are flagged by GET /admin/metrics/stale.
METRIC_STALE_DAYS=180

# ── Binary media and offsite backup storage ──────────────────────────────
# Local development/test adapter:
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_LOCAL_DIR="./uploads"
MEDIA_PUBLIC_BASE_URL="http://localhost:4000/media/files"
MEDIA_UPLOAD_MAX_BYTES=10485760
#
# Production uses an S3-compatible private write bucket with a public CDN
# origin for media reads. Prefer workload/IAM identity; only set static
# credentials when the provider has no identity integration.
# MEDIA_STORAGE_DRIVER=s3
# MEDIA_PUBLIC_BASE_URL="https://media.example.com"
# S3_REGION=af-south-1
# S3_BUCKET=lake-group-production
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Published website release trigger ────────────────────────────────────
# A successful publish/unpublish/rollback is detected from PublicationEvent
# rows and dispatched to the protected GitHub Actions release workflow.
PUBLIC_RELEASE_ENABLED=false
# PUBLIC_RELEASE_GITHUB_REPOSITORY="owner/repository"
# Fine-grained token: Contents write access for only that repository
# (required by GitHub's repository-dispatch endpoint).
# PUBLIC_RELEASE_GITHUB_TOKEN=
# PUBLIC_RELEASE_API_BASE_URL="https://api.example.com"
PUBLIC_RELEASE_POLL_MS=15000
PUBLIC_RELEASE_MAX_ATTEMPTS=8

# ── Production checklist (NODE_ENV=production) ────────────────────────────
# The boot check enforces: owner + distinct least-privilege runtime database
# URLs, SESSION_SECRET >= 32 chars, SESSION_COOKIE_SECURE=true, and a valid
# HTTPS CMS origin present in both CMS_ALLOWED_ORIGINS and
# CSRF_ALLOWED_ORIGINS. Production must run behind HTTPS (TLS at the platform
# or reverse proxy), bind PostgreSQL to a private interface, and set
# an exact TRUST_PROXY topology. See docs/CMS-PRODUCTION-DEPLOYMENT.md.

# ── User creation script (scripts/create-user.js) ────────────────────────
# Password source when creating a user without --password:
#   CREATE_USER_PASSWORD="a strong password"
