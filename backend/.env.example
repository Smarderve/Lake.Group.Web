# =============================================================
# Lake Group CMS — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# =============================================================

# PostgreSQL connection string used by the Payload Postgres adapter.
# Local:  postgres://lake:lake_change_me@localhost:5432/lakegroup_cms
# Docker: postgres://lake:lake_change_me@db:5432/lakegroup_cms  (service name is "db")
DATABASE_URI=postgres://lake:lake_change_me@localhost:5432/lakegroup_cms

# Long random secret used to sign auth tokens and encrypt payloads.
# Generate one with:  openssl rand -base64 48
PAYLOAD_SECRET=change_me_generate_a_long_random_string

# Public URL of this CMS (used for admin redirects and absolute links).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Comma-separated origins allowed to call the REST API from the browser.
# The static site (Vercel / company servers) goes here, e.g.:
# CORS_ORIGINS=https://www.lakeoilgroup.com,http://localhost:5500
# For local news.html testing, include the static server origin too
# (scripts/_verify_cms_live.js serves the site root on http://localhost:8977).
CORS_ORIGINS=

# Comma-separated origins allowed to submit requests (CSRF protection).
CSRF_ORIGINS=

# Force schema auto-create/update on boot (default: dev only).
# Set to true for the FIRST production boot before migrations exist:
#   docker compose up -d   (then, once tables exist, set it back to false)
PAYLOAD_PUSH=false

# ---------------------------------------------------------------
# Docker Compose only — password for the bundled Postgres container.
# ---------------------------------------------------------------
POSTGRES_PASSWORD=lake_change_me
