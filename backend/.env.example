# ── Lake Group backend — environment template ────────────────────────────
# Copy this file to `.env` and replace the placeholders with your real
# values. NEVER commit `.env` — it is gitignored.

# ── Environment separation (SECURITY_ROADMAP Phase 1) ─────────────────────
# One of: development | testing | staging | production (default development).
# Production: /example dev routes are NOT mounted, secure cookies + HSTS are
# required, and the boot check refuses to start with weak secrets.
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
# Local PostgreSQL connection string. The database runs on the company
# server itself (localhost) — no external or paid services.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# SECURITY_ROADMAP Phase 6 — least-privilege split:
#   DATABASE_URL         = lake_user (migration/DDL owner) — used by
#                          `npm run db:migrate`, seeds, backup/restore.

# SECURITY_ROADMAP Phase 20 — backup/DR. Optional AES-256-GCM encryption-
# at-rest for dumps: set a long random passphrase to make backups opaque
# (BACKUP_ENCRYPTION_KEY). Retention: BACKUP_RETENTION_DAYS (default 14, 0 =
# keep everything) prunes dumps older than the window after each backup.
# See docs/security/disaster-recovery.md.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_RETENTION_DAYS=14
#   DATABASE_URL_RUNTIME = lake_app  (DML-only runtime role, no DDL) — used
#                          by the running server + session store.
# Provision the role once per cluster: node scripts/db-roles.js
# (see docs/security/phase-06-report.md).
DATABASE_URL="postgresql://lake_user:change_me@localhost:5432/lakegroup?schema=public"
DATABASE_URL_RUNTIME="postgresql://lake_app:change_me_too@localhost:5432/lakegroup?schema=public"

# ── Server ───────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=4000

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Set to 1 when the server sits behind a reverse proxy (nginx/caddy) so
# client IPs are read from X-Forwarded-For (rate limiting + audit logs).
# Also gates the CSRF origin check: X-Forwarded-Host/Proto are trusted ONLY
# when TRUST_PROXY > 0 — a direct client can otherwise spoof them.
TRUST_PROXY=0

# ── Auth & sessions (Phase 2) ────────────────────────────────────────────
# Session signing secret. Generate a strong one, e.g.:
#   openssl rand -hex 32
SESSION_SECRET="change_me_generate_a_real_random_value"

# Session cookie lifetime in ms (default 8 hours). With rolling sessions
# (below) this acts as an inactivity timeout, not a fixed lifetime.
SESSION_TTL_MS=28800000

# Idle expiry (SECURITY_ROADMAP Phase 3): re-set the session cookie on
# activity so SESSION_TTL_MS becomes a max-inactivity window. Default true;
# set "false" for a fixed (non-extending) session lifetime.
SESSION_ROLLING=true

# Window (ms) within which a session counts as "recently authenticated"
# for privileged actions (default 15 minutes).
RECENT_AUTH_WINDOW_MS=900000

# bcrypt cost factor for password hashing (default 12 — above bcrypt's
# own default of 10). Higher = slower but stronger.
BCRYPT_COST=12

# Force secure (HTTPS-only) session cookies. Auto-enabled when
# NODE_ENV=production; set to "false" only if the server is not behind TLS.
SESSION_COOKIE_SECURE=false

# ── CSRF (SECURITY_ROADMAP Phase 8) ────────────────────────────────────
# Extra origins allowed to send state-changing requests to /admin and /auth
# (the static admin UI lives on another origin in dev/test/prod). Same-host
# is always allowed. Comma-separated. Leave empty to allow only same-origin.
#   CSRF_ALLOWED_ORIGINS="http://127.0.0.1:8796,https://cms.example.com"
CSRF_ALLOWED_ORIGINS="http://127.0.0.1:8796"

# ── Metrics governance (Phase 3) ────────────────────────────────────────
# Stale-data window: metrics whose verificationDate is older than this
# many days (or never set) are flagged by GET /admin/metrics/stale.
METRIC_STALE_DAYS=180

# ── Production checklist (NODE_ENV=production) ────────────────────────────
# The boot check enforces: DATABASE_URL set, SESSION_SECRET >= 32 chars,
# SESSION_COOKIE_SECURE=true. Production must also run behind HTTPS (TLS at
# the reverse proxy), bind PostgreSQL to a private interface, and set
# TRUST_PROXY=1 behind the proxy. See docs/PHASE-11-HARDENING-PRODUCTION.md.

# ── User creation script (scripts/create-user.js) ────────────────────────
# Password source when creating a user without --password:
#   CREATE_USER_PASSWORD="a strong password"
